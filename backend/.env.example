# ═══════════════════════════════════════════════════════
# AI Job Agent v2.1.0 — Environment Configuration
# ═══════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# Never commit the .env file to version control.
# ═══════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────
APP_NAME=AI Job Application Agent
APP_VERSION=2.1.0
APP_DEBUG=false                          # Enable debug mode (true/false)
APP_SECRET_KEY=change-me-to-a-secure-random-key  # Required: JWT signing key (min 32 chars)
APP_ACCESS_TOKEN_EXPIRE_MINUTES=30       # JWT token expiry in minutes

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_job_agent
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/ai_job_agent
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_job_agent_test
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# ── Logging ───────────────────────────────────────────
LOG_LEVEL=INFO                           # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=console                       # console (pretty) or json (structured)

# ── CORS ──────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Uploads ───────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.doc,.docx,.txt

# ── Auth ──────────────────────────────────────────────
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Resume ────────────────────────────────────────────
RESUME_TEMPLATE_DIR=templates/resumes
DEFAULT_RESUME_TEMPLATE=modern

# ── Browser Automation ────────────────────────────────
BROWSER_AUTOMATION_ENABLED=false
BROWSER_HEADLESS=true
BROWSER_SCREENSHOT_DIR=uploads/screenshots
BROWSER_DEFAULT_TIMEOUT_MS=30000

# ── Applications ──────────────────────────────────────
APPLICATIONS_DAILY_LIMIT_DEFAULT=10
APPLICATIONS_SCHEDULER_INTERVAL_MINUTES=15
NOTIFICATIONS_ENABLED=true

# ── AI ────────────────────────────────────────────────
AI_DEFAULT_PROVIDER=openrouter           # Default AI provider to use
AI_DEFAULT_MODEL=gpt-4o                  # Default model
AI_FALLBACK_MODEL=gpt-3.5-turbo          # Fallback if primary fails
AI_FALLBACK_PROVIDER=                    # Fallback provider (empty = same as default)
AI_MAX_RETRIES=3                         # Max retries on provider failure
AI_RETRY_DELAY_SECONDS=1                 # Delay between retries
AI_TIMEOUT_SECONDS=60                    # Request timeout in seconds
AI_TEMPERATURE=                          # Model temperature (0.0-2.0, empty = provider default)
AI_MAX_TOKENS=                           # Max tokens in response (empty = model default)
AI_STREAMING_ENABLED=false
AI_ENABLED_PROVIDERS=openrouter,ollama,openai,anthropic,gemini

# ═══════════════════════════════════════════════════════
# AI PROVIDER CREDENTIALS
# Only configure the providers you intend to use.
# ═══════════════════════════════════════════════════════

# ── OpenRouter ──
OPENROUTER_API_KEY=                      # https://openrouter.ai/keys
OPENROUTER_BASE_URL=https://openrouter.ai
OPENROUTER_DEFAULT_MODEL=gpt-4o

# ── OpenAI ──
OPENAI_API_KEY=                          # https://platform.openai.com/api-keys
OPENAI_BASE_URL=https://api.openai.com
OPENAI_DEFAULT_MODEL=gpt-4o

# ── Anthropic ──
ANTHROPIC_API_KEY=                       # https://console.anthropic.com/
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514

# ── Gemini ──
GEMINI_API_KEY=                          # https://aistudio.google.com/app/apikey
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_DEFAULT_MODEL=gemini-2.0-flash

# ── Ollama (local) ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3

# ═══════════════════════════════════════════════════════
# JOB PROVIDERS
# ═══════════════════════════════════════════════════════

ENABLED_JOB_PROVIDERS_CSV=greenhouse,lever,ashby,wellfound,workday
JOB_REQUEST_TIMEOUT_SECONDS=30
JOB_RETRY_COUNT=2
JOB_DEFAULT_SEARCH_LIMIT=25

# ── Adzuna (optional) ──
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# ═══════════════════════════════════════════════════════
# SMTP / EMAIL (optional — for password reset)
# ═══════════════════════════════════════════════════════

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com

# ── Webhook (optional) ──
WEBHOOK_SECRET=
