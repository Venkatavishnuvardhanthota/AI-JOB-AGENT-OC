# ── Application ──
APP_NAME=AI Job Application Agent
APP_VERSION=2.0.0
APP_DEBUG=false
APP_SECRET_KEY=change-me-to-a-secure-random-key
APP_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Database ──
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_job_agent
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/ai_job_agent
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_job_agent_test

# ── Logging ──
LOG_LEVEL=INFO

# ── CORS ──
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Uploads ──
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.doc,.docx,.txt

# ── Auth ──
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Resume ──
RESUME_TEMPLATE_DIR=templates/resumes
DEFAULT_RESUME_TEMPLATE=modern

# ── Browser Automation ──
BROWSER_AUTOMATION_ENABLED=false
BROWSER_HEADLESS=true
BROWSER_SCREENSHOT_DIR=uploads/screenshots
BROWSER_DEFAULT_TIMEOUT_MS=30000

# ── Applications ──
APPLICATIONS_DAILY_LIMIT_DEFAULT=10
APPLICATIONS_SCHEDULER_INTERVAL_MINUTES=15
NOTIFICATIONS_ENABLED=true

# ── AI ──
AI_DEFAULT_PROVIDER=openrouter
AI_DEFAULT_MODEL=gpt-4o
AI_FALLBACK_MODEL=gpt-3.5-turbo
AI_FALLBACK_PROVIDER=
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=60

# ── OpenRouter ──
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai
OPENROUTER_DEFAULT_MODEL=gpt-4o

# ── Ollama ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3

# ── Job Providers ──
ENABLED_JOB_PROVIDERS=linkedin,greenhouse,lever,ashby,wellfound,workday

# ── Adzuna ──
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# ── SMTP (for password reset emails) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com

# ── Webhook ──
WEBHOOK_SECRET=
